#!/bin/bash
#
# EM-Skill Pre-Commit Hook
# Source: agent-skills + GSD best practices
#
# Runs before each commit to ensure code quality
#

set -e

echo "🔍 EM-Skill Pre-Commit Checks"
echo "=============================="

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check for staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|py|go|rs)$' || true)
if [ -z "$STAGED_FILES" ]; then
    echo "ℹ️  No code files staged, skipping checks"
    exit 0
fi

echo "📝 Staged files:"
echo "$STAGED_FILES" | sed 's/^/  - /'
echo ""

# 1. Type Check (if available)
if command_exists tsc && [ -f "tsconfig.json" ]; then
    echo "🔎 Running TypeScript type check..."
    if tsc --noEmit; then
        echo -e "${GREEN}✓ Type check passed${NC}"
    else
        echo -e "${RED}✗ Type check failed${NC}"
        echo "   Please fix type errors before committing"
        exit 1
    fi
    echo ""
fi

# 2. Lint (if available)
if command_exists npm && npm run lint:check >/dev/null 2>&1; then
    echo "🔎 Running linter..."
    if npm run lint:check; then
        echo -e "${GREEN}✓ Lint check passed${NC}"
    else
        echo -e "${YELLOW}⚠ Lint issues found${NC}"
        echo "   Run 'npm run lint:fix' to auto-fix"
        read -p "   Continue anyway? (y/N) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 1
        fi
    fi
    echo ""
elif command_exists npm && npm run lint >/dev/null 2>&1; then
    echo "🔎 Running linter..."
    if npm run lint; then
        echo -e "${GREEN}✓ Lint check passed${NC}"
    else
        echo -e "${YELLOW}⚠ Lint issues found${NC}"
        exit 1
    fi
    echo ""
fi

# 3. Unit Tests (if available) with TDD Auto-Retry
if command_exists npm && npm run test:unit >/dev/null 2>&1; then
    echo "🧪 Running unit tests with TDD auto-retry..."

    # Source TDD retry wrapper
    if [[ -f "./tests/tdd-retry-wrapper.sh" ]]; then
        source "./tests/tdd-retry-wrapper.sh"

        # Run tests with retry logic
        if run_tdd_with_retry "npm run test:unit -- --passWithNoTests" 3; then
            echo -e "${GREEN}✓ Unit tests passed${NC}"
        else
            local exit_code=$?
            case $exit_code in
                42)
                    echo -e "${YELLOW}⚠ Tests failed - retry available${NC}"
                    echo "   Error context has been saved for AI to fix"
                    echo "   TDD Iron Law: NO PRODUCTION CODE WITHOUT FAILING TEST"
                    exit 1
                    ;;
                43)
                    echo -e "${RED}✗ Tests failed - max retries exceeded${NC}"
                    echo "   Manual intervention required"
                    echo "   Run './tests/tdd-context-manager.sh format' to see error details"
                    echo "   TDD Iron Law: NO PRODUCTION CODE WITHOUT FAILING TEST"
                    exit 1
                    ;;
                *)
                    echo -e "${RED}✗ Test execution error${NC}"
                    exit 1
                    ;;
            esac
        fi
    else
        # Fallback to direct execution if wrapper not available
        echo -e "${YELLOW}⚠ TDD wrapper not found, running tests directly${NC}"
        if npm run test:unit -- --passWithNoTests; then
            echo -e "${GREEN}✓ Unit tests passed${NC}"
        else
            echo -e "${RED}✗ Unit tests failed${NC}"
            echo "   Please fix failing tests before committing"
            echo "   TDD Iron Law: NO PRODUCTION CODE WITHOUT FAILING TEST"
            exit 1
        fi
    fi
    echo ""
elif command_exists npm && npm run test >/dev/null 2>&1; then
    echo "🧪 Running tests with TDD auto-retry..."

    # Source TDD retry wrapper
    if [[ -f "./tests/tdd-retry-wrapper.sh" ]]; then
        source "./tests/tdd-retry-wrapper.sh"

        # Run tests with retry logic
        if run_tdd_with_retry "npm run test -- --passWithNoTests" 3; then
            echo -e "${GREEN}✓ Tests passed${NC}"
        else
            local exit_code=$?
            case $exit_code in
                42)
                    echo -e "${YELLOW}⚠ Tests failed - retry available${NC}"
                    echo "   Error context has been saved for AI to fix"
                    exit 1
                    ;;
                43)
                    echo -e "${RED}✗ Tests failed - max retries exceeded${NC}"
                    echo "   Manual intervention required"
                    exit 1
                    ;;
                *)
                    echo -e "${RED}✗ Test execution error${NC}"
                    exit 1
                    ;;
            esac
        fi
    else
        # Fallback to direct execution if wrapper not available
        echo -e "${YELLOW}⚠ TDD wrapper not found, running tests directly${NC}"
        if npm run test -- --passWithNoTests; then
            echo -e "${GREEN}✓ Tests passed${NC}"
        else
            echo -e "${RED}✗ Tests failed${NC}"
            exit 1
        fi
    fi
    echo ""
fi

# 4. Check for common issues
echo "🔎 Checking for common issues..."

# Check for console.log in committed files
if git diff --cached --name-only | xargs grep -l "console.log" 2>/dev/null | grep -q .; then
    echo -e "${YELLOW}⚠ Warning: console.log found in committed files${NC}"
    echo "   Consider removing debug logs before committing"
fi

# Check for TODO/FIXME without issue reference
TODO_COUNT=$(git diff --cached --name-only | xargs grep -E "TODO|FIXME" 2>/dev/null | grep -vE "TODO:.*#[0-9]+" | wc -l)
if [ "$TODO_COUNT" -gt 0 ]; then
    echo -e "${YELLOW}⚠ Warning: $TODO_COUNT TODO/FIXME without issue reference${NC}"
    echo "   Consider creating issues for tracking"
fi

# Check for large files (>500KB)
LARGE_FILES=$(git diff --cached --name-only | while read file; do
    if [ -f "$file" ]; then
        SIZE=$(du -k "$file" | cut -f1)
        if [ "$SIZE" -gt 500 ]; then
            echo "$file ($(du -h "$file" | cut -f1))"
        fi
    fi
done)

if [ -n "$LARGE_FILES" ]; then
    echo -e "${YELLOW}⚠ Warning: Large files detected${NC}"
    echo "$LARGE_FILES" | sed 's/^/   - /'
    echo "   Consider using Git LFS for large files"
fi

# 5. Workflow Stage Artifact Checks
# Verifies that workflow stages weren't skipped by checking for expected artifacts.
# Control: EM_WORKFLOW_STRICT=strict to block commits, default is warn-only.
echo ""
echo "🔎 Checking workflow stage artifacts..."

GATE_FAILED=false

gate_warn() {
    if [[ "${EM_WORKFLOW_STRICT:-warn}" == "strict" ]]; then
        echo -e "${RED}✗ GATE BLOCKED: $1${NC}"
        GATE_FAILED=true
    else
        echo -e "${YELLOW}⚠ GATE WARNING: $1${NC}"
    fi
}

# 5a. DEFINE gate — Spec should exist if code changes are substantial
SRC_COUNT=$(echo "$STAGED_FILES" | wc -l | tr -d ' ')
if [[ "$SRC_COUNT" -gt 3 ]]; then
    SPEC_EXISTS=false
    for dir in spec specs docs/specs; do
        if [[ -d "$dir" ]] && ls "$dir"/*.md >/dev/null 2>&1; then
            SPEC_EXISTS=true
            break
        fi
    done
    if [[ "$SPEC_EXISTS" == "false" ]]; then
        gate_warn "No spec found (spec/, specs/, docs/specs/) but $SRC_COUNT source files changed"
        gate_warn "Iron Law: NO CODE WITHOUT SPEC (for features)"
    fi
fi

# 5b. VERIFY gate — Test evidence should exist if spec exists
SPEC_EXISTS=false
for dir in spec specs docs/specs; do
    if [[ -d "$dir" ]] && ls "$dir"/*.md >/dev/null 2>&1; then
        SPEC_EXISTS=true
        break
    fi
done

if [[ "$SPEC_EXISTS" == "true" ]]; then
    EVIDENCE_FOUND=false
    for artifact in \
        "test-results/tc-registry.md" \
        "test-results" \
        "playwright-report" \
        "e2e/test-results"; do
        if [[ -e "$artifact" ]]; then
            EVIDENCE_FOUND=true
            break
        fi
    done
    if [[ "$EVIDENCE_FOUND" == "false" ]]; then
        STAGED_TESTS=$(git diff --cached --name-only | grep -E '\.(test|spec)\.(ts|tsx|js|jsx|py)$|test_[^/]*\.py$|[^/]*_test\.(py|go)$' || true)
        if [[ -z "$STAGED_TESTS" ]]; then
            gate_warn "Spec exists but no test evidence found (tc-registry, test-results/, or test files in commit)"
            gate_warn "VERIFY stage may have been skipped — see protocols/error-handling.md"
        fi
    fi
fi

# 5c. TDD gate — Source changes should include test changes
STAGED_TESTS=$(git diff --cached --name-only | grep -E '\.(test|spec)\.(ts|tsx|js|jsx|py)$|test_[^/]*\.py$|[^/]*_test\.(py|go)$' || true)
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|py|go|rs)$' | grep -vE '\.(test|spec)\.|test_|_test\.' || true)

if [[ -n "$STAGED_SRC" ]] && [[ -z "$STAGED_TESTS" ]]; then
    gate_warn "Source files changed but no test files in commit"
    gate_warn "TDD Iron Law: NO PRODUCTION CODE WITHOUT FAILING TEST"
fi

if [[ "$GATE_FAILED" == "true" ]]; then
    echo ""
    echo -e "${RED}✗ Workflow gate checks failed. Set EM_WORKFLOW_STRICT=warn to downgrade to warnings.${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
echo "   Ready to commit with atomic commit message"
